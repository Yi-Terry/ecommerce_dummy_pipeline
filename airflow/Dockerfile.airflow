# Extends the official Airflow image with the packages the generator needs
# (faker, kafka-python, databricks-sql-connector, etc.) so BashOperator tasks
# that run generator.py have everything installed already.
FROM apache/airflow:3.3.1-python3.11

COPY requirements-airflow.txt /requirements-airflow.txt
RUN pip install --no-cache-dir -r /requirements-airflow.txt \
    --constraint "https://raw.githubusercontent.com/apache/airflow/constraints-3.3.1/constraints-3.11.txt"